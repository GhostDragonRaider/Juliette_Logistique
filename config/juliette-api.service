[Unit]
Description=Juliette Logistique Admin API
After=network.target

[Service]
Type=simple
User=juliette-api
Group=juliette-api
WorkingDirectory=/opt/juliette-api
Environment=NODE_ENV=production
Environment=PORT=3010
Environment=DATA_DIR=/opt/juliette-api/data
Environment=ADMIN_USER=admin
Environment=TOKEN_SECRET=juliette-prod-token-v1-change-me
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
